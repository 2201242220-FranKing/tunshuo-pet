# Python 运行期缓存（不删文件，只是不纳入版本库）
__pycache__/
*.py[cod]

# macOS 系统文件
.DS_Store

# 打包产物（由 make_app.py 生成，随时可重建，不入库）
build/

# 一键安装脚本创建的虚拟环境与运行日志（由 bootstrap.py 生成，随时可重建）
.venv/
venv/
logs/

# 运行时状态（喂小鱼干计数等，每次启动自动生成）
state.json
state.json.tmp

# 形象工作台下发的缓存与配饰图片（运行时自动拉取，随时可重新下载）
studio_cache.json
studio_cache.json.tmp
assets/accessories/
# 工作台下发的皮肤包（运行时自动拉取）；内置 placeholder 验证包随仓库保留
assets/skins/*/
!assets/skins/placeholder/
